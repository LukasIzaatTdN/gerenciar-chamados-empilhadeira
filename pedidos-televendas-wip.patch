+import { readFile } from "node:fs/promises";
+import { before, after, test } from "node:test";
+import { assertFails, assertSucceeds, initializeTestEnvironment } from "@firebase/rules-unit-testing";
+import { collection, doc, getDoc, getDocs, query, setDoc, updateDoc, where } from "firebase/firestore";
+
+const environment = await initializeTestEnvironment({
+  projectId: "demo-patio-pro-log",
+  firestore: {
+    host: "127.0.0.1", port: Number(process.env.PATIO_FIRESTORE_EMULATOR_PORT || "8080"),
+    rules: await readFile(new URL("../../../firestore.rules", import.meta.url), "utf8"),
+  },
+});
+const user = (uid) => environment.authenticatedContext(uid).firestore();
+const scopedQuery = (db, empresa, loja, uid) => query(collection(db, "chamados"),
+  where("empresa_id", "==", empresa), where("supermercado_id", "==", loja), where("solicitante_uid", "==", uid));
+const chamado = (id, uid, empresa = "a", loja = "loja-a") => ({
+  id, empresa_id: empresa, supermercado_id: loja, ...(uid === undefined ? {} : { solicitante_uid: uid }),
+  solicitante_nome: "Nome igual", setor: "Setor", categoria: "televendas", tipo_servico: "Atendimento Televendas",
+  prioridade: "Normal", criado_em: "2026-01-01", status: "Aberto", numero_pedido: "123", cliente: "Cliente",
+  itens: [{ nome: "item" }], local_separacao: "Loja", prazo_limite: "2026-01-02",
+  empilhadeira_id: null, empilhadeira_identificacao: null, operador_nome: null, assumido_em: null,
+  a_caminho_em: null, cheguei_em: null, iniciado_em: null, finalizado_em: null, cancelado_em: null,
+  atualizado_em: null, atualizado_por: null, motivo_incompleto: null, observacao_operador: null,
+});
+
+before(async () => environment.withSecurityRulesDisabled(async (context) => {
+  const db = context.firestore();
+  for (const empresa of ["a", "b"]) await setDoc(doc(db, "empresas", empresa), { status: "Ativa" });
+  for (const [loja, empresa] of [["loja-a", "a"], ["loja-a2", "a"], ["loja-b", "b"]])
+    await setDoc(doc(db, "supermercados", loja), { empresa_id: empresa, status: "Ativo" });
+  for (const [uid, perfil, empresa, loja, status] of [
+    ["seller", "Televendas", "a", "loja-a", "Ativo"], ["seller2", "Televendas", "a", "loja-a", "Ativo"],
+    ["inactive", "Televendas", "a", "loja-a", "Inativo"], ["separator", "Separador de Televendas", "a", "loja-a", "Ativo"],
+    ["supervisor", "Supervisor", "a", "loja-a", "Ativo"], ["operator", "Operador", "a", "loja-a", "Ativo"],
+    ["admin", "Administrador da Empresa", "a", null, "Ativo"], ["platform", "Administrador Geral", null, null, "Ativo"],
+  ]) await setDoc(doc(db, "usuarios", uid), { perfil, empresa_id: empresa, supermercado_id: loja, status });
+  for (const data of [chamado("own", "seller"), chamado("other", "seller2"), chamado("legacy", undefined),
+    chamado("other-unit", "seller", "a", "loja-a2"), chamado("other-company", "seller", "b", "loja-b"),
+    chamado("wrong-company", "seller", "b", "loja-a"), chamado("inactive-own", "inactive")])
+    await setDoc(doc(db, "chamados", data.id), data);
+}));
+after(async () => environment.cleanup());
+
+test("seller reads only own UID in both company and unit, including queries", async () => {
+  const db = user("seller");
+  await assertSucceeds(getDoc(doc(db, "chamados/own")));
+  for (const id of ["other", "legacy", "other-unit", "other-company", "wrong-company"])
+    await assertFails(getDoc(doc(db, "chamados", id)));
+  const result = await assertSucceeds(getDocs(scopedQuery(db, "a", "loja-a", "seller")));
+  if (result.docs.length !== 1 || result.docs[0].id !== "own") throw new Error("unexpected seller query results");
+  await assertFails(getDocs(query(collection(db, "chamados"), where("supermercado_id", "==", "loja-a"))));
+  await assertFails(getDocs(query(collection(db, "chamados"), where("empresa_id", "==", "a"), where("supermercado_id", "==", "loja-a"))));
+  await assertFails(getDocs(scopedQuery(db, "a", "loja-a", "seller2")));
+  await assertFails(getDoc(doc(user("inactive"), "chamados/inactive-own")));
+  await assertFails(getDoc(doc(environment.unauthenticatedContext().firestore(), "chamados/own")));
+});
+
+test("seller creation must bind authenticated UID and tenant; UID cannot be changed by a manager", async () => {
+  const db = user("seller");
+  await assertSucceeds(setDoc(doc(db, "chamados/new"), chamado("new", "seller")));
+  await assertFails(setDoc(doc(db, "chamados/no-uid"), chamado("no-uid", undefined)));
+  await assertFails(setDoc(doc(db, "chamados/fake-uid"), chamado("fake-uid", "seller2")));
+  await assertFails(setDoc(doc(db, "chamados/wrong-unit"), chamado("wrong-unit", "seller", "a", "loja-a2")));
+  await assertFails(updateDoc(doc(user("supervisor"), "chamados/other"), { solicitante_uid: "seller" }));
+  await assertFails(updateDoc(doc(user("supervisor"), "chamados/legacy"), { solicitante_uid: "seller" }));
+});
+
+test("separator, supervisor, operator and admins retain existing queue access", async () => {
+  for (const uid of ["separator", "supervisor", "operator"]) {
+    const db = user(uid);
+    await assertSucceeds(getDoc(doc(db, "chamados/other")));
+    await assertSucceeds(getDoc(doc(db, "chamados/legacy")));
+    await assertSucceeds(getDocs(query(collection(db, "chamados"), where("supermercado_id", "==", "loja-a"))));
+  }
+  await assertSucceeds(updateDoc(doc(user("separator"), "chamados/other"), { status: "Em separação" }));
+  await assertSucceeds(getDocs(query(collection(user("admin"), "chamados"), where("empresa_id", "==", "a"))));
+  await assertSucceeds(getDocs(collection(user("platform"), "chamados")));
+});
