+            ) : <p className="mt-3 text-sm text-slate-600">Itens não disponíveis.</p>}
+            {pedido.motivo_incompleto && <p className="mt-3 text-sm text-slate-700">Motivo: {pedido.motivo_incompleto}</p>}
+            {pedido.observacao_operador && <p className="mt-2 text-sm text-slate-700">Observação do responsável: {pedido.observacao_operador}</p>}
+            {pedido.observacoes && <p className="mt-2 text-sm text-slate-700">Observação do pedido: {pedido.observacoes}</p>}
+          </article>
+        ))}
     </section>
   );
 }
