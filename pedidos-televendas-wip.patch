diff --git a/src/utils/pedidosProprios.test.ts b/src/utils/pedidosProprios.test.ts
new file mode 100644
index 0000000..55df82d
--- /dev/null
+++ b/src/utils/pedidosProprios.test.ts
@@ -0,0 +1,19 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+import { filtrarPedidosProprios, quantidadesParaExibicao } from "./pedidosProprios.ts";
+
+test("pedidos são filtrados por UID e vínculos, incluindo em andamento", () => {
+  const base = { id: "1", solicitante_uid: "uid-a", empresa_id: "empresa", supermercado_id: "unidade", categoria: "televendas" as const, status: "Em separação" as const };
+  const pedidos = [base, { ...base, id: "2", solicitante_uid: "uid-b", solicitante_nome: "Mesmo nome" }, { ...base, id: "3", empresa_id: "outra" }, { ...base, id: "4", supermercado_id: "outra" }, { ...base, id: "5", solicitante_uid: null }, { ...base, id: "6", categoria: "operacional" as const }];
+  assert.deepEqual(filtrarPedidosProprios(pedidos, "uid-a", "empresa", "unidade").map((p) => p.id), ["1"]);
+  assert.deepEqual(filtrarPedidosProprios(pedidos, null, "empresa", "unidade"), []);
+});
+
+test("zero inicial não é apresentado como falta conferida", () => {
+  const item = { quantidadeSolicitada: 5, quantidadeEncontrada: 0, quantidadeFaltante: 5 };
+  for (const status of ["Aberto", "Em separação", "Finalizado", "Cancelado"] as const) {
+    assert.deepEqual(quantidadesParaExibicao(status, item), { solicitado: 5, encontrado: "Não confirmado", faltante: "Não confirmado" });
+  }
+  assert.deepEqual(quantidadesParaExibicao("Incompleto", item), { solicitado: 5, encontrado: 0, faltante: 5 });
+  assert.deepEqual(quantidadesParaExibicao("Pronto", { ...item, quantidadeEncontrada: 5, quantidadeFaltante: 0 }), { solicitado: 5, encontrado: 5, faltante: 0 });
+});
diff --git a/src/utils/pedidosProprios.ts b/src/utils/pedidosProprios.ts
new file mode 100644
index 0000000..70482f2
--- /dev/null
+++ b/src/utils/pedidosProprios.ts
@@ -0,0 +1,33 @@
+import type { Chamado, ItemTelevendas } from "../types/chamado";
+
+type Pedido = Partial<Chamado> & { id: string };
+
+// Filtro adicional de apresentação, não substitui autorização no servidor.
+export function filtrarPedidosProprios(
+  pedidos: Pedido[], usuarioUid: string | null, empresaId: string | null, supermercadoId: string | null,
+): Pedido[] {
+  if (!usuarioUid || !empresaId || !supermercadoId) return [];
+  return pedidos.filter((pedido) =>
+    pedido.solicitante_uid === usuarioUid && pedido.empresa_id === empresaId &&
+    pedido.supermercado_id === supermercadoId &&
+    (pedido.categoria === "televendas" || pedido.tipo_servico === "Atendimento Televendas")
+  ).sort((a, b) => (b.criado_em || "").localeCompare(a.criado_em || ""));
+}
+
+// O modelo antigo inicializa encontrado e faltante com zeros antes da conferência.
+// Apenas Pronto/Incompleto indicam gravação da conferência pela ação de separação.
+// Nos demais estados, um zero (inclusive em Finalizado/Cancelado legados) é ambíguo.
+export function quantidadesParaExibicao(status: Chamado["status"] | undefined, item: Partial<ItemTelevendas>) {
+  const numero = (value: unknown): number | null =>
+    typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
+  const solicitado = numero(item.quantidadeSolicitada);
+  const encontrado = numero(item.quantidadeEncontrada);
+  const faltante = numero(item.quantidadeFaltante);
+  const conferido = status === "Pronto" || status === "Incompleto";
+  const encontradoVisivel = encontrado !== null && (conferido || encontrado > 0);
+  return {
+    solicitado: solicitado ?? "Não informado",
+    encontrado: encontradoVisivel ? encontrado : "Não confirmado",
+    faltante: encontradoVisivel && faltante !== null ? faltante : "Não confirmado",
+  };
+}
