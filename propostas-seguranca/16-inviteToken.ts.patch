--- /dev/null
+++ b/src/utils/inviteToken.ts
@@ -0,0 +1,8 @@
+// 256 random bits; fail closed where a cryptographic RNG is unavailable.
+export function createInviteToken(random: Pick<Crypto, "getRandomValues"> | undefined = globalThis.crypto): string {
+  if (!random || typeof random.getRandomValues !== "function") {
+    throw new Error("Gerador seguro indisponível. Use um navegador com suporte a criptografia para gerar o convite.");
+  }
+  const bytes = random.getRandomValues(new Uint8Array(32));
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
