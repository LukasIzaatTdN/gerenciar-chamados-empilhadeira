rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasCurrentUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isCurrentUserActive() {
      return hasCurrentUserDoc()
        && (
          !("status" in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == "Ativo"
        );
    }

    function isAdminGeral() {
      return isCurrentUserActive()
        && currentUserPerfil() == "Administrador Geral";
    }

    // SaaS privilege is intentionally stricter than the shared operational helper:
    // a missing user status must never grant platform subscription management.
    function isActiveSaasPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == "Administrador Geral"
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == "Ativo";
    }

    function isActiveSaasCompanyAdmin(empresaId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == "Administrador da Empresa"
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == "Ativo"
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresa_id == empresaId;
    }

    function isSaasPlanValid(planId, data) {
      return data.keys().hasAll([
          "id", "nome", "descricao", "valor_centavos", "ciclo",
          "status", "criado_em", "atualizado_em", "ultima_operacao_id"
        ])
        && data.keys().hasOnly([
          "id", "nome", "descricao", "valor_centavos", "ciclo", "limite_usuarios",
          "limite_filiais", "status", "criado_em", "atualizado_em", "ultima_operacao_id"
        ])
        && data.id == planId
        && data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 80
        && data.descricao is string && data.descricao.size() <= 500
        && data.valor_centavos is int && data.valor_centavos >= 0 && data.valor_centavos <= 100000000
        && data.ciclo in ["Mensal", "Trimestral", "Semestral", "Anual"]
        && (data.get("limite_usuarios", null) == null || (data.limite_usuarios is int && data.limite_usuarios >= 1 && data.limite_usuarios <= 100000))
        && (data.get("limite_filiais", null) == null || (data.limite_filiais is int && data.limite_filiais >= 1 && data.limite_filiais <= 100000))
        && data.status in ["Ativo", "Inativo"]
        && data.criado_em is timestamp && data.atualizado_em == request.time
        && data.ultima_operacao_id is string;
    }

    function saasHistoryPath(empresaId, operationId) {
      return /databases/$(database)/documents/empresas/$(empresaId)/historico_assinatura/$(operationId);
    }

    function saasAuditPath(operationId) {
      return /databases/$(database)/documents/auditoria_assinaturas/$(operationId);
    }

    function saasOperationPath(operationId) {
      return /databases/$(database)/documents/assinatura_operacoes/$(operationId);
    }

    function isSaasSubscriptionValid(empresaId, data, oldData, operationId, action) {
      let planPath = /databases/$(database)/documents/planos/$(data.plano_id);
      let plan = get(planPath).data;
      let companyPath = /databases/$(database)/documents/empresas/$(empresaId);
      let event = getAfter(saasHistoryPath(empresaId, operationId)).data;
      let priorStatus = "status" in oldData ? oldData.status : null;
      let allowedTransition = action == "assignPlan"
          ? (priorStatus == null ? data.status == "Pendente" : priorStatus in ["Pendente", "Ativa", "Expirada"] && data.status == priorStatus)
          : action == "activate"
            ? priorStatus == "Pendente" && data.status == "Ativa"
            : action == "renew" && priorStatus in ["Ativa", "Expirada"] && data.status == "Ativa";
      return data.keys().hasAll([
          "empresa_id", "plano_id", "plano_nome", "status", "ciclo", "valor_centavos",
          "inicio_em", "vence_em", "renovacao_manual", "cobranca_automatica",
          "provedor_pagamento", "criado_em", "atualizado_em", "atualizado_por",
          "ultima_operacao_id"
        ])
        && exists(companyPath) && exists(planPath)
        && existsAfter(saasHistoryPath(empresaId, operationId))
        && plan.status == "Ativo"
        && data.keys().hasOnly([
          "empresa_id", "plano_id", "plano_nome", "status", "ciclo", "valor_centavos",
          "inicio_em", "vence_em", "renovacao_manual", "cobranca_automatica", "provedor_pagamento",
          "criado_em", "atualizado_em", "atualizado_por", "ultima_operacao_id"
        ])
        && data.empresa_id == empresaId
        && data.plano_id is string && data.plano_nome == plan.nome
        && data.ciclo == plan.ciclo && data.valor_centavos == plan.valor_centavos
        && data.status in ["Pendente", "Ativa", "Expirada"]
        && data.renovacao_manual == true && data.cobranca_automatica == false && data.provedor_pagamento == null
        && data.criado_em is timestamp && data.atualizado_em == request.time
        && data.atualizado_por == request.auth.uid && data.ultima_operacao_id == operationId
        && allowedTransition
        && (
          action == "assignPlan"
            ? data.inicio_em == ("inicio_em" in oldData ? oldData.inicio_em : null)
              && data.vence_em == ("vence_em" in oldData ? oldData.vence_em : null)
            : data.inicio_em is timestamp && data.vence_em is timestamp
              && event.detalhes.inicio_em is timestamp
              && event.detalhes.vence_em is timestamp
              && data.vence_em > event.detalhes.inicio_em
              && event.detalhes.vence_em == data.vence_em
              && (
                action == "activate"
                  ? data.inicio_em == request.time && event.detalhes.inicio_em == request.time
                  : data.inicio_em == oldData.inicio_em
                    && (
                      oldData.vence_em is timestamp && oldData.vence_em > request.time
                        ? event.detalhes.inicio_em == oldData.vence_em
                        : event.detalhes.inicio_em == request.time
                    )
              )
              && (
                plan.ciclo == "Mensal" ? data.vence_em - event.detalhes.inicio_em >= duration.value(27, "d") && data.vence_em - event.detalhes.inicio_em <= duration.value(32, "d")
                  : plan.ciclo == "Trimestral" ? data.vence_em - event.detalhes.inicio_em >= duration.value(88, "d") && data.vence_em - event.detalhes.inicio_em <= duration.value(93, "d")
                  : plan.ciclo == "Semestral" ? data.vence_em - event.detalhes.inicio_em >= duration.value(180, "d") && data.vence_em - event.detalhes.inicio_em <= duration.value(185, "d")
                  : plan.ciclo == "Anual" && data.vence_em - event.detalhes.inicio_em >= duration.value(364, "d") && data.vence_em - event.detalhes.inicio_em <= duration.value(367, "d")
              )
        )
        && getAfter(saasHistoryPath(empresaId, operationId)).data.operation_id == operationId
        && getAfter(saasHistoryPath(empresaId, operationId)).data.empresa_id == empresaId
        && getAfter(saasHistoryPath(empresaId, operationId)).data.plano_id == data.plano_id
        && (
          action == "assignPlan" ? getAfter(saasHistoryPath(empresaId, operationId)).data.acao == "plano_vinculado"
            : action == "activate" ? getAfter(saasHistoryPath(empresaId, operationId)).data.acao == "assinatura_ativada"
            : getAfter(saasHistoryPath(empresaId, operationId)).data.acao == "assinatura_renovada"
        );
    }

    function isSaasHistoryValid(empresaId, operationId, data) {
      let op = getAfter(saasOperationPath(operationId)).data;
      return data.keys().hasAll(["acao", "empresa_id", "plano_id", "operation_id", "ator_uid", "ator_nome", "ocorrido_em", "detalhes"])
        && data.keys().hasOnly(["acao", "empresa_id", "plano_id", "operation_id", "ator_uid", "ator_nome", "ocorrido_em", "detalhes"])
        && data.empresa_id == empresaId && data.plano_id is string
        && data.operation_id == operationId && data.ator_uid == request.auth.uid
        && data.ator_nome is string && data.ocorrido_em == request.time
        && data.acao in ["plano_vinculado", "assinatura_ativada", "assinatura_renovada"]
        && data.detalhes is map
        && existsAfter(saasOperationPath(operationId))
        && op.target_id == empresaId && op.action in ["assignPlan", "activate", "renew"]
        && op.actor_uid == request.auth.uid
        && op.request_data.empresaId == empresaId
        && op.request_data.planId == data.plano_id
        && (
          data.acao == "plano_vinculado"
            ? op.action == "assignPlan" && data.detalhes.plano_nome is string
            : data.acao == "assinatura_ativada"
              ? op.action == "activate"
              : op.action == "renew"
        );
    }

    function isSaasOperationValid(operationId, data) {
      return data.keys().hasAll(["operation_id", "actor_uid", "action", "request_data", "target_id", "result", "processed_at"])
        && data.keys().hasOnly(["operation_id", "actor_uid", "action", "request_data", "target_id", "result", "processed_at"])
        && data.operation_id == operationId && data.actor_uid == request.auth.uid
        && data.action in ["savePlan", "assignPlan", "activate", "renew"]
        && data.request_data is map && data.result is map && data.processed_at == request.time
        && data.target_id is string
        && (data.action == "savePlan"
          ? data.request_data.get("plan", null) is map
          : data.request_data.keys().hasAll(["empresaId", "planId"])
            && data.request_data.empresaId == data.target_id
            && data.request_data.planId is string);
    }

    function isAdminEmpresa() {
      return isCurrentUserActive()
        && currentUserPerfil() == "Administrador da Empresa";
    }

    function hasAdminManagementAccess() {
      return isAdminGeral() || isAdminEmpresa();
    }

    function currentUserEmpresaId() {
      return hasCurrentUserDoc()
        && "empresa_id" in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresa_id is string
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresa_id.size() > 0
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresa_id
        : null;
    }

    function currentUserSupermercadoId() {
      return hasCurrentUserDoc()
        && "supermercado_id" in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.supermercado_id is string
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.supermercado_id.size() > 0
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.supermercado_id
        : null;
    }

    // The web client resolves a user's company from the linked unit when older
    // user documents do not carry empresa_id. Keep Separator reads aligned with
    // that behavior, while still constraining access to the user's exact unit.
    function isCurrentUserInEmpresaScope(empresaId) {
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      let user = get(userPath).data;
      let unitId = user.get("supermercado_id", null);
      let safeUnitId = unitId is string && unitId.size() > 0 ? unitId : "__unidade_nao_definida__";
      let unitPath = /databases/$(database)/documents/supermercados/$(safeUnitId);
      return user.get("empresa_id", null) == empresaId
        || (user.get("empresa_id", null) == null
          && unitId is string
          && unitId.size() > 0
          && exists(unitPath)
          && get(unitPath).data.get("empresa_id", null) == empresaId);
    }

    function currentUserPerfil() {
      return hasCurrentUserDoc()
        && "perfil" in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil is string
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil.size() > 0
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil
        : null;
    }

    function isSupervisorDaUnidade(supermercadoId) {
      return isSignedIn()
        && (
          currentUserPerfil() == "Supervisor"
          || currentUserPerfil() == "Separador de Televendas"
        )
        && currentUserSupermercadoId() != null
        && currentUserSupermercadoId() == supermercadoId;
    }

    function isAdminEmpresaDaEmpresa(empresaId) {
      return isSignedIn()
        && currentUserPerfil() == "Administrador da Empresa"
        && currentUserEmpresaId() != null
        && currentUserEmpresaId() == empresaId;
    }

    function isPerfilValido(perfilInput) {
      return perfilInput == "Promotor"
        || perfilInput == "Funcionário"
        || perfilInput == "Operador"
        || perfilInput == "Supervisor"
        || perfilInput == "Televendas"
        || perfilInput == "Separador de Televendas"
        || perfilInput == "Administrador da Empresa"
        || perfilInput == "Administrador Geral";
    }

    function isPerfilAutoCadastroPermitido(perfilInput) {
      return perfilInput == "Promotor"
        || perfilInput == "Funcionário"
        || perfilInput == "Operador"
        || perfilInput == "Supervisor"
        || perfilInput == "Televendas"
        || perfilInput == "Separador de Televendas";
    }

    function isConviteAdminEmpresaValido(token) {
      return token is string
        && token.size() > 0
        && exists(/databases/$(database)/documents/convites_admin_empresa/$(token))
        && get(/databases/$(database)/documents/convites_admin_empresa/$(token)).data.status == "Pendente"
        && get(/databases/$(database)/documents/convites_admin_empresa/$(token)).data.perfil == "Administrador da Empresa"
        && get(/databases/$(database)/documents/convites_admin_empresa/$(token)).data.empresa_id
          == request.resource.data.empresa_id
        && get(/databases/$(database)/documents/convites_admin_empresa/$(token)).data.expira_em_ms
          > request.time.toMillis();
    }

    function isCadastroAdminEmpresaPorConviteValido() {
      return request.resource.data.perfil == "Administrador da Empresa"
        && request.resource.data.supermercado_id == null
        && request.resource.data.convite_token is string
        && isConviteAdminEmpresaValido(request.resource.data.convite_token);
    }

    function isEmpresaAtiva(empresaId) {
      return empresaId is string
        && empresaId.size() > 0
        && exists(/databases/$(database)/documents/empresas/$(empresaId))
        && (
          !(
            "status" in get(/databases/$(database)/documents/empresas/$(empresaId)).data
          )
          || get(/databases/$(database)/documents/empresas/$(empresaId)).data.status == "Ativa"
        );
    }

    function isSupermercadoAtivo(supermercadoId) {
      return supermercadoId is string
        && supermercadoId.size() > 0
        && exists(/databases/$(database)/documents/supermercados/$(supermercadoId))
        && (
          !(
            "status" in get(/databases/$(database)/documents/supermercados/$(supermercadoId)).data
          )
          || get(/databases/$(database)/documents/supermercados/$(supermercadoId)).data.status == "Ativo"
        );
    }

    function isSupermercadoDaEmpresaAtivo(empresaId, supermercadoId) {
      return isEmpresaAtiva(empresaId)
        && isSupermercadoAtivo(supermercadoId)
        && get(/databases/$(database)/documents/supermercados/$(supermercadoId)).data.empresa_id == empresaId;
    }

    function isEmpresaVinculoValido(perfilInput, empresaId) {
      return (
        perfilInput == "Administrador Geral" && empresaId == null
      ) || (
        perfilInput != "Administrador Geral" && isEmpresaAtiva(empresaId)
      );
    }

    function isSupermercadoVinculoValido(perfilInput, empresaId, supermercadoId) {
      return (
        perfilInput == "Administrador Geral"
        && (
          supermercadoId == null
          || isSupermercadoDaEmpresaAtivo(empresaId, supermercadoId)
        )
      ) || (
        perfilInput == "Administrador da Empresa"
        && supermercadoId == null
        && isEmpresaAtiva(empresaId)
      ) || (
        perfilInput != "Administrador Geral"
        && perfilInput != "Administrador da Empresa"
        && isSupermercadoDaEmpresaAtivo(empresaId, supermercadoId)
      );
    }

    function isUsuarioVinculoValido(data) {
      return isPerfilValido(data.perfil)
        && (!("status" in data) || isStatusUsuarioValido(data.status))
        && isEmpresaVinculoValido(data.perfil, data.empresa_id)
        && isSupermercadoVinculoValido(
          data.perfil,
          data.empresa_id,
          data.supermercado_id
        );
    }

    function canAdminEmpresaManageUser(existingData, newData) {
      return isAdminEmpresa()
        && existingData.perfil != "Administrador Geral"
        && newData.perfil != "Administrador Geral"
        && existingData.empresa_id == currentUserEmpresaId()
        && newData.empresa_id == currentUserEmpresaId()
        && isUsuarioVinculoValido(newData);
    }

    function hasOnlyUserManagementChanges(existingData, newData) {
      return newData.diff(existingData).affectedKeys().hasOnly([
        "perfil",
        "empresa_id",
        "supermercado_id",
        "supermercado_ids",
        "status",
        "atualizado_em"
      ]);
    }

    function canAccessEmpresa(empresaId) {
      return isAdminGeral()
        || isAdminEmpresaDaEmpresa(empresaId);
    }

    function belongsToEmpresa(empresaId) {
      return isCurrentUserActive()
        && currentUserEmpresaId() != null
        && currentUserEmpresaId() == empresaId;
    }

    function canAccessCurrentSupermercado(supermercadoId) {
      return isCurrentUserActive()
        && currentUserSupermercadoId() is string
        && currentUserSupermercadoId().size() > 0
        && currentUserSupermercadoId() == supermercadoId;
    }

    function canCreateChamado(data) {
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(userPath)
        && canCreateChamadoForUser(data, get(userPath).data);
    }

    function canCreateChamadoForUser(data, user) {
      let perfil = user.get("perfil", null);
      return (!("status" in user) || user.status == "Ativo")
        && isPerfilValido(perfil)
        && (data.categoria == "televendas" || perfil != "Separador de Televendas");
    }

    function isTelevendasChamado(data) {
      return data.get("categoria", null) == "televendas"
        || data.get("tipo_servico", null) == "Atendimento Televendas";
    }

    function canManageChamado(data) {
      let perfil = currentUserPerfil();
      return perfil == "Supervisor"
        || perfil == "Administrador da Empresa"
        || perfil == "Administrador Geral"
        || (perfil == "Separador de Televendas" && isTelevendasChamado(data));
    }

    // Bounded transition for the Televendas separator taking an open order.
    // Keep this separate from the general update validator: the latter checks
    // unrelated order/receipt fields and can exceed Firestore's expression cap.
    function isScopedTelevendasAssumeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("categoria", null) == "televendas"
        && resource.data.status == "Aberto"
        && request.resource.data.status == "Em separação"
        && changed.hasOnly(["status", "operador_nome", "assumido_em", "atualizado_em"])
        && changed.hasAll(["status", "operador_nome", "assumido_em", "atualizado_em"])
        && currentUserPerfil() == "Separador de Televendas"
        && isCurrentUserActive()
        && isCurrentUserInEmpresaScope(resource.data.empresa_id)
        && currentUserSupermercadoId() == resource.data.supermercado_id
        && isCampoVazio(resource.data.get("operador_nome", null))
        && isCampoVazio(resource.data.get("assumido_em", null))
        && request.resource.data.id == resource.data.id
        && request.resource.data.empresa_id == resource.data.empresa_id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        && isTextoNaoVazio(request.resource.data.operador_nome)
        && isTextoNaoVazio(request.resource.data.assumido_em)
        && isTextoNaoVazio(request.resource.data.atualizado_em);
    }

    function isScopedTelevendasLegacyObservationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("categoria", null) == "televendas"
        && changed.hasOnly(["observacao_operador"])
        && currentUserPerfil() == "Separador de Televendas"
        && isCurrentUserActive()
        && currentUserSupermercadoId() == resource.data.supermercado_id
        && isCurrentUserInEmpresaScope(resource.data.empresa_id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.empresa_id == resource.data.empresa_id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        && request.resource.data.status == resource.data.status
        && request.resource.data.observacao_operador is string;
    }

    function isActiveOperatorScopedToCall(data) {
      let actorPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      let actor = get(actorPath).data;
      return actor.get("perfil", null) == "Operador"
        && actor.get("status", null) == "Ativo"
        && actor.get("supermercado_id", null) == data.supermercado_id
        && isSupermercadoDaEmpresaAtivo(data.empresa_id, data.supermercado_id);
    }

    function currentOperatorProfileName() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get("nome", null);
    }

    function isOperatorEquipmentAssignmentValid(data) {
      let equipmentChanged = request.resource.data.get("empilhadeira_id", null)
          != resource.data.get("empilhadeira_id", null)
        || request.resource.data.get("empilhadeira_identificacao", null)
          != resource.data.get("empilhadeira_identificacao", null);
      let equipmentId = request.resource.data.get("empilhadeira_id", null);
      let equipmentPath = /databases/$(database)/documents/empilhadeiras/$(equipmentId);
      return !equipmentChanged
        || (
          (isCampoVazio(equipmentId)
            && isCampoVazio(request.resource.data.get("empilhadeira_identificacao", null)))
          || (
            isTextoNaoVazio(equipmentId)
            && isTextoNaoVazio(request.resource.data.get("empilhadeira_identificacao", null))
            && exists(equipmentPath)
            && get(equipmentPath).data.id == equipmentId
            && get(equipmentPath).data.identificacao == request.resource.data.empilhadeira_identificacao
            && get(equipmentPath).data.empresa_id == resource.data.empresa_id
            && get(equipmentPath).data.supermercado_id == resource.data.supermercado_id
            && isStatusEmpilhadeiraCompativelComChamado(get(equipmentPath).data.status)
          )
        );
    }

    function isOperatorAssumeCallUpdate(changed) {
      return resource.data.status == "Aguardando"
        && isCampoVazio(resource.data.get("operador_nome", null))
        && isCampoVazio(resource.data.get("assumido_em", null))
        && request.resource.data.status == "Aguardando"
        && request.resource.data.operador_nome == currentOperatorProfileName()
        && isTextoNaoVazio(request.resource.data.operador_nome)
        && isCampoVazio(resource.data.get("a_caminho_em", null))
        && isCampoVazio(resource.data.get("cheguei_em", null))
        && isCampoVazio(resource.data.get("iniciado_em", null))
        && isCampoVazio(resource.data.get("finalizado_em", null))
        && changed.hasOnly([
          "operador_nome", "assumido_em", "atualizado_em",
          "empilhadeira_id", "empilhadeira_identificacao"
        ])
        && changed.hasAll(["operador_nome", "assumido_em", "atualizado_em"])
        && isTextoNaoVazio(request.resource.data.assumido_em)
        && isTextoNaoVazio(request.resource.data.atualizado_em)
        && isOperatorEquipmentAssignmentValid(request.resource.data);
    }

    function isOperatorRouteUpdate(changed) {
      return resource.data.status == "Aguardando"
        && resource.data.operador_nome == currentOperatorProfileName()
        && isTextoNaoVazio(resource.data.operador_nome)
        && isTextoNaoVazio(resource.data.get("assumido_em", null))
        && isCampoVazio(resource.data.get("a_caminho_em", null))
        && isCampoVazio(resource.data.get("cheguei_em", null))
        && request.resource.data.status == resource.data.status
        && request.resource.data.operador_nome == resource.data.operador_nome
        && request.resource.data.assumido_em == resource.data.assumido_em
        && isTextoNaoVazio(request.resource.data.a_caminho_em)
        && isCampoVazio(request.resource.data.get("cheguei_em", null))
        && changed.hasOnly(["status", "operador_nome", "assumido_em", "a_caminho_em", "atualizado_em"])
        && changed.hasAll(["a_caminho_em", "atualizado_em"])
        && isTextoNaoVazio(request.resource.data.atualizado_em);
    }

    function isOperatorArrivalUpdate(changed) {
      return resource.data.status == "Aguardando"
        && resource.data.operador_nome == currentOperatorProfileName()
        && isTextoNaoVazio(resource.data.operador_nome)
        && isTextoNaoVazio(resource.data.get("assumido_em", null))
        && isTextoNaoVazio(resource.data.get("a_caminho_em", null))
        && isCampoVazio(resource.data.get("cheguei_em", null))
        && request.resource.data.status == resource.data.status
        && request.resource.data.operador_nome == resource.data.operador_nome
        && request.resource.data.assumido_em == resource.data.assumido_em
        && request.resource.data.a_caminho_em == resource.data.a_caminho_em
        && isTextoNaoVazio(request.resource.data.cheguei_em)
        && changed.hasOnly([
          "status", "operador_nome", "assumido_em", "a_caminho_em", "cheguei_em", "atualizado_em"
        ])
        && changed.hasAll(["cheguei_em", "atualizado_em"])
        && isTextoNaoVazio(request.resource.data.atualizado_em);
    }

    function isOperatorStartUpdate(changed) {
      return resource.data.status == "Aguardando"
        && resource.data.operador_nome == currentOperatorProfileName()
        && isTextoNaoVazio(resource.data.operador_nome)
        && isCampoVazio(resource.data.get("iniciado_em", null))
        && request.resource.data.status == "Em atendimento"
        && request.resource.data.operador_nome == resource.data.operador_nome
        && request.resource.data.atualizado_por == currentOperatorProfileName()
        && isTextoNaoVazio(request.resource.data.iniciado_em)
        && (isCampoVazio(resource.data.get("assumido_em", null))
          ? request.resource.data.assumido_em == request.resource.data.iniciado_em
          : request.resource.data.assumido_em == resource.data.assumido_em)
        && (isCampoVazio(resource.data.get("a_caminho_em", null))
          ? request.resource.data.a_caminho_em == request.resource.data.iniciado_em
          : request.resource.data.a_caminho_em == resource.data.a_caminho_em)
        && (isCampoVazio(resource.data.get("cheguei_em", null))
          ? request.resource.data.cheguei_em == request.resource.data.iniciado_em
          : request.resource.data.cheguei_em == resource.data.cheguei_em)
        && isCampoVazio(request.resource.data.get("finalizado_em", null))
        && isCampoVazio(request.resource.data.get("cancelado_em", null))
        && isTextoNaoVazio(request.resource.data.atualizado_em)
        && changed.hasOnly([
          "status", "iniciado_em", "operador_nome", "assumido_em", "a_caminho_em",
          "cheguei_em", "finalizado_em", "cancelado_em", "atualizado_em", "atualizado_por",
          "empilhadeira_id", "empilhadeira_identificacao"
        ])
        && changed.hasAll(["status", "iniciado_em", "atualizado_em", "atualizado_por"])
        && isOperatorEquipmentAssignmentValid(request.resource.data);
    }

    function isOperatorFinishUpdate(changed) {
      return resource.data.status == "Em atendimento"
        && resource.data.operador_nome == currentOperatorProfileName()
        && isTextoNaoVazio(resource.data.get("iniciado_em", null))
        && request.resource.data.status == "Finalizado"
        && request.resource.data.operador_nome == resource.data.operador_nome
        && request.resource.data.atualizado_por == currentOperatorProfileName()
        && isTextoNaoVazio(request.resource.data.finalizado_em)
        && changed.hasOnly([
          "status", "finalizado_em", "operador_nome", "cancelado_em", "atualizado_em", "atualizado_por"
        ])
        // `atualizado_por` is already set by the start action and can remain
        // unchanged in Firestore's diff; still require it to match the actor.
        && changed.hasAll(["status", "finalizado_em", "atualizado_em"])
        && isTextoNaoVazio(request.resource.data.atualizado_em);
    }

    function isScopedOperatorCallUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("categoria", null) != "televendas"
        && resource.data.get("tipo_servico", null) != "Atendimento Televendas"
        && isActiveOperatorScopedToCall(resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.empresa_id == resource.data.empresa_id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        && (changed.hasAny(["finalizado_em"])
          ? isOperatorFinishUpdate(changed)
          : changed.hasAny(["iniciado_em"])
            ? isOperatorStartUpdate(changed)
            : changed.hasAny(["cheguei_em"])
              ? isOperatorArrivalUpdate(changed)
              : changed.hasAny(["a_caminho_em"])
                ? isOperatorRouteUpdate(changed)
                : isOperatorAssumeCallUpdate(changed));
    }

    // Keep the Operator's transition audit small and bound it to the call
    // changed in the same atomic commit. This avoids falling through the
    // generic audit scope checks, which require a stored empresa_id on older
    // user profiles and can exceed the expression budget.
    function isOperatorCallActionAudit(id) {
      let callPath = /databases/$(database)/documents/chamados/$(request.resource.data.entityId);
      let actorPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      let afterCall = getAfter(callPath).data;
      let actor = get(actorPath).data;
      return request.resource.data.action in [
          "chamado_assumido", "chamado_iniciado", "chamado_finalizado"
        ]
        && request.resource.data.keys().hasOnly([
          "action", "actorUid", "actorName", "entityType", "entityId",
          "details", "occurredAt", "empresa_id", "supermercado_id"
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName == actor.get("nome", null)
        && request.resource.data.entityType == "chamado"
        && request.resource.data.entityId is string
        && request.resource.data.details is map
        && request.resource.data.occurredAt is string
        && actor.get("status", null) == "Ativo"
        && actor.get("perfil", null) == "Operador"
        && actor.get("supermercado_id", null) == request.resource.data.supermercado_id
        && afterCall.empresa_id == request.resource.data.empresa_id
        && afterCall.supermercado_id == request.resource.data.supermercado_id
        && afterCall.operador_nome == actor.get("nome", null)
        && request.resource.data.details.empresa_id == request.resource.data.empresa_id
        && request.resource.data.details.supermercado_id == request.resource.data.supermercado_id
        && request.resource.data.details.operador_nome == actor.get("nome", null)
        && request.resource.data.details.statusAtual == afterCall.status
        && exists(callPath)
        && exists(actorPath)
        && (request.resource.data.action == "chamado_assumido"
          ? afterCall.status == "Aguardando"
            && isTextoNaoVazio(afterCall.get("assumido_em", null))
            && isCampoVazio(afterCall.get("iniciado_em", null))
          : request.resource.data.action == "chamado_iniciado"
            ? afterCall.status == "Em atendimento"
              && isTextoNaoVazio(afterCall.get("iniciado_em", null))
            : afterCall.status == "Finalizado"
              && isTextoNaoVazio(afterCall.get("finalizado_em", null)));
    }

    function isStatusUsuarioValido(status) {
      return status == "Ativo" || status == "Inativo";
    }

    function isTextoNaoVazio(valor) {
      return valor is string && valor.size() > 0;
    }

    function isCampoVazio(valor) {
      return valor == null || (valor is string && valor.size() == 0);
    }

    function isStatusChamadoValido(status) {
      return status == "Aguardando"
        || status == "Em atendimento"
        || status == "Finalizado"
        || status == "Aberto"
        || status == "Em separação"
        || status == "Incompleto"
        || status == "Pronto"
        || status == "Cancelado";
    }

    function isPrioridadeValida(prioridade) {
      return prioridade == "Normal" || prioridade == "Urgente";
    }

    function isTipoServicoValido(tipo) {
      return tipo == "Descarga"
        || tipo == "Reposição"
        || tipo == "Retirada"
        || tipo == "Movimentação"
        || tipo == "Apoio interno"
        || tipo == "Atendimento Televendas";
    }

    function isCategoriaValida(categoria) {
      return categoria == "operacional" || categoria == "televendas";
    }

    function isStatusEmpilhadeiraValido(status) {
      return status == "Disponível"
        || status == "Em uso"
        || status == "Em manutenção"
        || status == "Inativa"
        || status == "Necessita atenção"
        || status == "Reserva";
    }

    function isStatusEmpilhadeiraCompativelComChamado(status) {
      return status == "Disponível"
        || status == "Em uso"
        || status == "Reserva";
    }

    function isEmpilhadeiraValida(data, id) {
      return data.id == id
        && isTextoNaoVazio(data.empresa_id)
        && isSupermercadoDaEmpresaAtivo(data.empresa_id, data.supermercado_id)
        && isTextoNaoVazio(data.identificacao)
        && isTextoNaoVazio(data.modelo)
        && isTextoNaoVazio(data.numero_interno)
        && isStatusEmpilhadeiraValido(data.status)
        && (isCampoVazio(data.observacoes) || isTextoNaoVazio(data.observacoes))
        && isTextoNaoVazio(data.criado_em)
        && isTextoNaoVazio(data.atualizado_em);
    }

    function isChecklistEmpilhadeiraValido(data, id) {
      return data.id == id
        && isSupermercadoDaEmpresaAtivo(data.empresa_id, data.supermercado_id)
        && isTextoNaoVazio(data.empilhadeira_id)
        && exists(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id))
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.empresa_id == data.empresa_id
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.supermercado_id == data.supermercado_id
        && isTextoNaoVazio(data.operador_id)
        && isTextoNaoVazio(data.operador_nome)
        && isTextoNaoVazio(data.data)
        && data.bateria_ok is bool
        && data.garfo_ok is bool
        && data.pneus_ok is bool
        && data.freio_ok is bool
        && data.sem_avaria is bool
        && data.reprovado is bool
        && data.itens_reprovados is list
        && (isCampoVazio(data.ocorrencia_tecnica) || isTextoNaoVazio(data.ocorrencia_tecnica))
        && (isCampoVazio(data.observacoes) || isTextoNaoVazio(data.observacoes))
        && (isCampoVazio(data.tratado_em) || isTextoNaoVazio(data.tratado_em))
        && (isCampoVazio(data.tratado_por) || isTextoNaoVazio(data.tratado_por))
        && isTextoNaoVazio(data.criado_em);
    }

    function canCreateChecklistEmpilhadeira(data) {
      return isAdminGeral()
        || isAdminEmpresaDaEmpresa(data.empresa_id)
        || (
          isCurrentUserActive()
          && (
            currentUserPerfil() == "Operador"
            || currentUserPerfil() == "Supervisor"
            || currentUserPerfil() == "Separador de Televendas"
          )
          && currentUserSupermercadoId() != null
          && currentUserSupermercadoId() == data.supermercado_id
        );
    }

    function isTipoManutencaoValido(tipo) {
      return tipo == "Preventiva"
        || tipo == "Corretiva"
        || tipo == "Inspecao"
        || tipo == "Revisao"
        || tipo == "Bateria";
    }

    function isPrioridadeManutencaoValida(prioridade) {
      return prioridade == "Baixa"
        || prioridade == "Media"
        || prioridade == "Alta"
        || prioridade == "Critica";
    }

    function isStatusManutencaoValido(status) {
      return status == "Aberta"
        || status == "Em andamento"
        || status == "Concluida"
        || status == "Cancelada";
    }

    function isManutencaoValida(data, id) {
      return data.id == id
        && isSupermercadoDaEmpresaAtivo(data.empresa_id, data.supermercado_id)
        && isTextoNaoVazio(data.empilhadeira_id)
        && exists(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id))
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.empresa_id == data.empresa_id
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.supermercado_id == data.supermercado_id
        && isTipoManutencaoValido(data.tipo)
        && isTextoNaoVazio(data.descricao)
        && isPrioridadeManutencaoValida(data.prioridade)
        && isStatusManutencaoValido(data.status)
        && (isCampoVazio(data.responsavel) || isTextoNaoVazio(data.responsavel))
        && isTextoNaoVazio(data.data_abertura)
        && (isCampoVazio(data.data_prevista) || isTextoNaoVazio(data.data_prevista))
        && (isCampoVazio(data.data_conclusao) || isTextoNaoVazio(data.data_conclusao))
        && isTextoNaoVazio(data.criado_por)
        && (isCampoVazio(data.observacoes) || isTextoNaoVazio(data.observacoes));
    }

    function canCreateManutencao(data) {
      return isAdminGeral()
        || isAdminEmpresaDaEmpresa(data.empresa_id)
        || isSupervisorDaUnidade(data.supermercado_id)
        || (
          isCurrentUserActive()
          && currentUserPerfil() == "Operador"
          && currentUserSupermercadoId() != null
          && currentUserSupermercadoId() == data.supermercado_id
        );
    }

    function canUpdateManutencao(data) {
      return isAdminGeral()
        || isAdminEmpresaDaEmpresa(data.empresa_id)
        || isSupervisorDaUnidade(data.supermercado_id);
    }

    function isEmpilhadeiraCompativelComChamado(data) {
      return (
        isCampoVazio(data.empilhadeira_id)
        && isCampoVazio(data.empilhadeira_identificacao)
      ) || (
        isTextoNaoVazio(data.empilhadeira_id)
        && isTextoNaoVazio(data.empilhadeira_identificacao)
        && exists(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id))
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.empresa_id == data.empresa_id
        && get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.supermercado_id == data.supermercado_id
        && isStatusEmpilhadeiraCompativelComChamado(
          get(/databases/$(database)/documents/empilhadeiras/$(data.empilhadeira_id)).data.status
        )
      );
    }

    // Operational calls may reference an in-separation Televendas pedido.
    // The link is a snapshot pointer only: it never writes to the parent.
    function isVinculoPedidoTelevendasValido(data) {
      let pedidoPath = /databases/$(database)/documents/chamados/$(data.pedido_origem_id);
      return data.categoria == "operacional"
        && data.tipo_servico in ["Descarga", "Reposição", "Retirada", "Movimentação", "Apoio interno"]
        && data.pedido_origem_id is string && data.pedido_origem_id.size() > 0
        && data.pedido_origem_item_index >= 0
        && data.pedido_origem_produto is string && data.pedido_origem_produto.size() > 0
        && data.localizacao_pallet is string && data.localizacao_pallet.size() > 0
        && exists(pedidoPath)
        && get(pedidoPath).data.categoria == "televendas"
        && get(pedidoPath).data.status == "Em separação"
        && get(pedidoPath).data.empresa_id == data.empresa_id
        && get(pedidoPath).data.supermercado_id == data.supermercado_id;
    }

    function isLinkedCallCreatorInScope(data) {
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      let user = get(userPath).data;
      return exists(userPath)
        && user.status == "Ativo"
        && user.perfil == "Separador de Televendas"
        && user.empresa_id == data.empresa_id
        && user.supermercado_id == data.supermercado_id;
    }

    function isLinkedOperationalCallReadableForSeparator(data) {
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return data.get("pedido_origem_id", null) is string
        && data.pedido_origem_id > ""
        && data.categoria == "operacional"
        && exists(userPath)
        && get(userPath).data.get("status", null) == "Ativo"
        && get(userPath).data.get("perfil", null) == "Separador de Televendas"
        && isCurrentUserInEmpresaScope(data.empresa_id)
        && get(userPath).data.supermercado_id == data.supermercado_id
        && isTelevendasPedidoVinculadoLegivel(data);
    }

    function isTelevendasPedidoVinculadoLegivel(data) {
      let pedidoPath = /databases/$(database)/documents/chamados/$(data.pedido_origem_id);
      return exists(pedidoPath)
        && get(pedidoPath).data.get("categoria", null) == "televendas"
        && get(pedidoPath).data.empresa_id == data.empresa_id
        && get(pedidoPath).data.supermercado_id == data.supermercado_id;
    }

    function canSeparatorReadChamado(data) {
      return currentUserPerfil() == "Separador de Televendas"
        && isCurrentUserActive()
        && isCurrentUserInEmpresaScope(data.empresa_id)
        && data.supermercado_id == currentUserSupermercadoId()
        && (
          isTelevendasChamado(data)
          || isLinkedOperationalCallReadableForSeparator(data)
        );
    }

    function isCriacaoChamadoValida() {
      return isTextoNaoVazio(request.resource.data.id)
        && isTextoNaoVazio(request.resource.data.empresa_id)
        && isTextoNaoVazio(request.resource.data.supermercado_id)
        && isSupermercadoDaEmpresaAtivo(
          request.resource.data.empresa_id,
          request.resource.data.supermercado_id
        )
        && isTextoNaoVazio(request.resource.data.solicitante_nome)
        && request.resource.data.solicitante_uid == request.auth.uid
        && isTextoNaoVazio(request.resource.data.setor)
        && isCategoriaValida(request.resource.data.categoria)
        && isTipoServicoValido(request.resource.data.tipo_servico)
        && isPrioridadeValida(request.resource.data.prioridade)
        && isTextoNaoVazio(request.resource.data.criado_em)
        && request.resource.data.itens is list
        && (
          (
            request.resource.data.categoria == "operacional"
            && request.resource.data.status == "Aguardando"
          )
          || (
            request.resource.data.categoria == "televendas"
            && request.resource.data.status == "Aberto"
            && request.resource.data.tipo_servico == "Atendimento Televendas"
            && isTextoNaoVazio(request.resource.data.numero_pedido)
            && isTextoNaoVazio(request.resource.data.cliente)
            && request.resource.data.itens.size() > 0
            && isTextoNaoVazio(request.resource.data.local_separacao)
            && isTextoNaoVazio(request.resource.data.prazo_limite)
          )
        )
        && isEmpilhadeiraCompativelComChamado(request.resource.data)
        && request.resource.data.operador_nome == null
        && request.resource.data.assumido_em == null
        && request.resource.data.a_caminho_em == null
        && request.resource.data.cheguei_em == null
        && request.resource.data.iniciado_em == null
        && request.resource.data.finalizado_em == null
        && request.resource.data.cancelado_em == null
        && request.resource.data.atualizado_em == null
        && request.resource.data.atualizado_por == null
        && request.resource.data.motivo_incompleto == null
        && request.resource.data.observacao_operador == null;
    }

    // Separate bounded validator so legacy creation paths keep their existing
    // expression budget while linked operational calls receive strict checks.
    function isCriacaoChamadoVinculadoValida(data) {
      return data.solicitante_uid == request.auth.uid
        && data.status == "Aguardando"
        && isLinkedCallCreatorInScope(data)
        && isVinculoPedidoTelevendasValido(data);
    }

    function isAtualizacaoChamadoValida() {
      let empilhadeiraAlterada = request.resource.data.get("empilhadeira_id", null)
          != resource.data.get("empilhadeira_id", null)
        || request.resource.data.get("empilhadeira_identificacao", null)
          != resource.data.get("empilhadeira_identificacao", null);
      return request.resource.data.id == resource.data.id
        && (
          request.resource.data.categoria == resource.data.categoria
          || isCampoVazio(resource.data.categoria)
        )
        && request.resource.data.empresa_id == resource.data.empresa_id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        && request.resource.data.get("pedido_origem_id", null) == resource.data.get("pedido_origem_id", null)
        && request.resource.data.get("pedido_origem_item_index", null) == resource.data.get("pedido_origem_item_index", null)
        && request.resource.data.get("pedido_origem_produto", null) == resource.data.get("pedido_origem_produto", null)
        && request.resource.data.get("localizacao_pallet", null) == resource.data.get("localizacao_pallet", null)
        && (("solicitante_uid" in resource.data)
          ? request.resource.data.solicitante_uid == resource.data.solicitante_uid
          : !("solicitante_uid" in request.resource.data))
        && isTextoNaoVazio(request.resource.data.id)
        && isTextoNaoVazio(request.resource.data.empresa_id)
        && isTextoNaoVazio(request.resource.data.supermercado_id)
        && isSupermercadoDaEmpresaAtivo(
          request.resource.data.empresa_id,
          request.resource.data.supermercado_id
        )
        && isStatusChamadoValido(request.resource.data.status)
        && (isCampoVazio(request.resource.data.operador_nome) || isTextoNaoVazio(request.resource.data.operador_nome))
        && (isCampoVazio(request.resource.data.assumido_em) || isTextoNaoVazio(request.resource.data.assumido_em))
        && (isCampoVazio(request.resource.data.a_caminho_em) || isTextoNaoVazio(request.resource.data.a_caminho_em))
        && (isCampoVazio(request.resource.data.cheguei_em) || isTextoNaoVazio(request.resource.data.cheguei_em))
        && (isCampoVazio(request.resource.data.iniciado_em) || isTextoNaoVazio(request.resource.data.iniciado_em))
        && (isCampoVazio(request.resource.data.finalizado_em) || isTextoNaoVazio(request.resource.data.finalizado_em))
        && (isCampoVazio(request.resource.data.cancelado_em) || isTextoNaoVazio(request.resource.data.cancelado_em))
        // Validate the equipment document when its assignment changes. Re-reading
        // it on every status transition can exceed Firestore's expression budget.
        && (!empilhadeiraAlterada || isEmpilhadeiraCompativelComChamado(request.resource.data));
    }

    // Bind the call-side marker to a newly created audit document in the
    // SAME atomic commit. A marker alone must never authorize an update.
    function hasNewMatchingTelevendasAudit() {
      let auditId = request.resource.data.ultima_auditoria_atualizacao_id;
      let auditPath = /databases/$(database)/documents/auditoria/$(auditId);
      return !exists(auditPath)
        && existsAfter(auditPath)
        && getAfter(auditPath).data.action == "chamado_atualizado"
        && getAfter(auditPath).data.entityType == "chamado"
        && getAfter(auditPath).data.entityId == resource.data.id
        && getAfter(auditPath).data.actorUid == request.auth.uid
        && getAfter(auditPath).data.empresa_id == resource.data.empresa_id
        && getAfter(auditPath).data.supermercado_id == resource.data.supermercado_id
        && getAfter(auditPath).data.details.statusAnterior == resource.data.status
        && getAfter(auditPath).data.details.statusAtual == request.resource.data.status
        && getAfter(auditPath).data.details.atualizado_em == request.resource.data.atualizado_em;
    }

    // Dedicated, bounded update path for Televendas audit batches. The
    // general call validator is expensive and cannot be combined with getAfter.
    function isScopedTelevendasAuditUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return resource.data.categoria == "televendas"
        && request.resource.data.categoria == "televendas"
        && request.resource.data.id == resource.data.id
        && request.resource.data.empresa_id == resource.data.empresa_id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        // Reject malformed or unrelated changes before any user-document reads.
        && changed.hasOnly([
          "itens", "produto", "quantidade", "total_solicitado",
          "total_encontrado", "percentual_atendido", "status",
          "motivo_incompleto", "observacao_operador", "atualizado_em",
          "atualizado_por", "operador_nome", "cancelado_em",
          "ultima_auditoria_atualizacao_id", "confirmacoes_empilhadeira",
          "ultima_separacao_confirmacao_id"
        ])
        && changed.hasAll(["ultima_auditoria_atualizacao_id", "atualizado_em"])
        && request.resource.data.get("confirmacoes_empilhadeira", {}).keys()
          .hasAll(resource.data.get("confirmacoes_empilhadeira", {}).keys())
        && (!changed.hasAny(["confirmacoes_empilhadeira"])
          || request.resource.data.confirmacoes_empilhadeira.diff(
            resource.data.get("confirmacoes_empilhadeira", {})
          ).affectedKeys().hasOnly([request.resource.data.get("ultima_separacao_confirmacao_id", "")]))
        // Once a forklift receipt exists, item totals are frozen against old
        // absolute edits. Manual receipts are recorded by the trusted callable;
        // client writes remain limited to linked-call receipts.
        && (!changed.hasAny(["itens"])
          || (resource.data.get("confirmacoes_empilhadeira", {}).size() == 0
            && resource.data.get("confirmacoes_manuais", {}).size() == 0)
          || hasNewMatchingSeparationConfirmation())
        && exists(userPath)
        && get(userPath).data.get("status", null) == "Ativo"
        && get(userPath).data.perfil in [
          "Supervisor", "Separador de Televendas",
          "Administrador da Empresa", "Administrador Geral"
        ]
        && (
          get(userPath).data.perfil == "Administrador Geral"
          || (
            get(userPath).data.perfil == "Administrador da Empresa"
            && get(userPath).data.empresa_id == resource.data.empresa_id
          )
          || (
            get(userPath).data.supermercado_id == resource.data.supermercado_id
            && get(userPath).data.empresa_id == resource.data.empresa_id
          )
        )
        && request.resource.data.ultima_auditoria_atualizacao_id is string
        && request.resource.data.ultima_auditoria_atualizacao_id.size() > 0
        && isStatusChamadoValido(request.resource.data.status)
        && request.resource.data.atualizado_em is string
        && request.resource.data.operador_nome is string
        && request.resource.data.atualizado_por == request.resource.data.operador_nome
        && hasNewMatchingTelevendasAudit()
        && (
          request.resource.data.get("ultima_separacao_confirmacao_id", null)
            == resource.data.get("ultima_separacao_confirmacao_id", null)
          || hasNewMatchingSeparationConfirmation()
        );
    }

    function hasNewMatchingSeparationConfirmation() {
      let confirmationId = request.resource.data.ultima_separacao_confirmacao_id;
      let receiptPath = /databases/$(database)/documents/chamados/$(resource.data.id)/separacao_confirmacoes/$(confirmationId);
      let marker = request.resource.data.confirmacoes_empilhadeira.get(confirmationId, null);
      return confirmationId is string
        && confirmationId.size() > 0
        && !exists(receiptPath)
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.chamado_id == confirmationId
        && getAfter(receiptPath).data.pedido_id == resource.data.id
        && getAfter(receiptPath).data.actor_uid == request.auth.uid
        && marker is map
        && marker.item_index == getAfter(receiptPath).data.item_index
        && marker.quantidade == getAfter(receiptPath).data.quantidade;
    }

    function isValidSeparationConfirmation(orderId, callId, data) {
      let orderPath = /databases/$(database)/documents/chamados/$(orderId);
      let callPath = /databases/$(database)/documents/chamados/$(callId);
      let orderBefore = get(orderPath).data;
      let orderAfter = getAfter(orderPath).data;
      let call = get(callPath).data;
      let index = data.item_index;
      let beforeItem = orderBefore.itens[index];
      let afterItem = orderAfter.itens[index];
      let marker = orderAfter.confirmacoes_empilhadeira.get(callId, null);
      return isCurrentUserActive()
        && currentUserPerfil() == "Separador de Televendas"
        && currentUserEmpresaId() == data.empresa_id
        && currentUserSupermercadoId() == data.supermercado_id
        && exists(orderPath)
        && exists(callPath)
        && isTelevendasChamado(orderBefore)
        && orderBefore.status == "Em separação"
        && orderBefore.empresa_id == data.empresa_id
        && orderBefore.supermercado_id == data.supermercado_id
        && call.categoria == "operacional"
        && call.status == "Finalizado"
        && call.empresa_id == data.empresa_id
        && call.supermercado_id == data.supermercado_id
        && call.pedido_origem_id == orderId
        && call.pedido_origem_item_index == index
        && call.pedido_origem_produto == beforeItem.produto
        && data.produto == beforeItem.produto
        && index is int && index >= 0 && index < orderBefore.itens.size()
        && data.quantidade is int && data.quantidade >= 0
        && data.unidade_medida == beforeItem.unidadeMedida
        && data.actor_uid == request.auth.uid
        && data.actor_nome is string && data.actor_nome.size() > 0
        && (data.quantidade > 0 || data.justificativa is string && data.justificativa.size() > 0)
        && data.confirmado_em == request.time
        && orderAfter.status == orderBefore.status
        && afterItem.produto == beforeItem.produto
        && afterItem.unidadeMedida == beforeItem.unidadeMedida
        && afterItem.quantidadeSolicitada == beforeItem.quantidadeSolicitada
        && beforeItem.quantidadeEncontrada + data.quantidade <= beforeItem.quantidadeSolicitada
        && afterItem.quantidadeEncontrada == beforeItem.quantidadeEncontrada + data.quantidade
        && afterItem.quantidadeFaltante == beforeItem.quantidadeSolicitada - afterItem.quantidadeEncontrada
        && marker.item_index == index
        && marker.quantidade == data.quantidade
        && marker.unidade_medida == data.unidade_medida
        && orderAfter.ultima_separacao_confirmacao_id == callId;
    }

    match /chamados/{id} {
      allow read: if isSignedIn()
        && (currentUserPerfil() == "Separador de Televendas"
          ? canSeparatorReadChamado(resource.data)
          : (
            canAccessCurrentSupermercado(resource.data.supermercado_id)
            || canAccessEmpresa(resource.data.empresa_id)
          ));

      allow create: if isSignedIn()
        && request.resource.data.id == id
        && (request.resource.data.get("pedido_origem_id", null) == null
          ? canCreateChamado(request.resource.data)
            && isCriacaoChamadoValida()
            && (
              canAccessCurrentSupermercado(request.resource.data.supermercado_id)
              || canAccessEmpresa(request.resource.data.empresa_id)
            )
          : isCriacaoChamadoVinculadoValida(request.resource.data));

      // Partition marker writes from legacy writes BEFORE evaluating either
      // branch. An invalid marker must not trigger the expensive legacy rule.
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["ultima_auditoria_atualizacao_id"])
          ? isScopedTelevendasAuditUpdate()
          : currentUserPerfil() == "Operador"
            ? isScopedOperatorCallUpdate()
            : (
              isScopedTelevendasLegacyObservationUpdate()
              || (resource.data.get("categoria", null) == "televendas"
                && isScopedTelevendasAssumeUpdate())
              || ((
                canAccessCurrentSupermercado(resource.data.supermercado_id)
                || canAccessEmpresa(resource.data.empresa_id)
              )
              && canManageChamado(resource.data)
              && !(resource.data.categoria == "televendas"
                && request.resource.data.diff(resource.data).affectedKeys().hasAny(["itens"])
                && (resource.data.get("confirmacoes_empilhadeira", {}).size() > 0
                  || resource.data.get("confirmacoes_manuais", {}).size() > 0))
              && isAtualizacaoChamadoValida()
              )
            )
        );

      allow delete: if isAdminGeral();

      match /separacao_confirmacoes/{confirmationId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/chamados/$(id))
          && (
            canAccessEmpresa(get(/databases/$(database)/documents/chamados/$(id)).data.empresa_id)
            || canAccessCurrentSupermercado(get(/databases/$(database)/documents/chamados/$(id)).data.supermercado_id)
          );
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll([
            "id", "pedido_id", "chamado_id", "item_index", "produto", "empresa_id",
            "supermercado_id", "actor_uid", "actor_nome", "quantidade", "unidade_medida",
            "justificativa", "confirmado_em"
          ])
          && request.resource.data.keys().hasOnly([
            "id", "pedido_id", "chamado_id", "item_index", "produto", "empresa_id",
            "supermercado_id", "actor_uid", "actor_nome", "quantidade", "unidade_medida",
            "justificativa", "confirmado_em"
          ])
          && confirmationId == request.resource.data.chamado_id
          && request.resource.data.id == confirmationId
          && request.resource.data.pedido_id == id
          && isValidSeparationConfirmation(id, confirmationId, request.resource.data);
        allow update, delete: if false;
      }
    }

    // Use a single user-document lookup for Televendas audit actor scope.
    function isTelevendasAuditActorInScope(data) {
      let userPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(userPath)
        && isTelevendasAuditActorInScopeForUser(data, get(userPath).data);
    }

    function isTelevendasAuditActorInScopeForUser(data, user) {
      return user.get("status", null) == "Ativo"
        && user.get("perfil", null) in [
          "Operador", "Supervisor", "Separador de Televendas",
          "Administrador da Empresa", "Administrador Geral"
        ]
        && (
          user.perfil == "Administrador Geral"
          || (
            user.get("empresa_id", null) == data.empresa_id
            && (
              user.perfil == "Administrador da Empresa"
              || user.get("supermercado_id", null) == data.supermercado_id
            )
          )
        );
    }

    // Require a new audit marker on the call in this atomic commit.
    // Keep this path deliberately small: the general call update rule is already
    // expensive and Firestore enforces a 1,000-expression evaluation limit.
    function isTelevendasUpdateAuditAuthentic(auditId, data) {
      return data.keys().hasAll([
          "entityType", "entityId", "details", "empresa_id", "supermercado_id"
        ])
        && data.entityType == "chamado"
        && data.entityId is string
        && data.entityId.size() > 0
        && data.details is map
        && data.details.keys().hasAll([
          "categoria", "statusAnterior", "statusAtual", "atualizado_em",
          "operador_nome", "empresa_id", "supermercado_id"
        ])
        && isTelevendasUpdateAuditAgainstCall(auditId, data);
    }

    function isTelevendasUpdateAuditAgainstCall(auditId, data) {
      let callPath = /databases/$(database)/documents/chamados/$(data.entityId);
      let previous = get(callPath).data;
      let current = getAfter(callPath).data;
      return data.entityType == "chamado"
        && data.entityId is string
        && data.empresa_id is string
        && data.supermercado_id is string
        // A missing call must be denied before dereferencing get().data.
        // Avoid adding existsAfter here until its expression cost is measured.
        && exists(callPath)
        && data.details.categoria == "televendas"
        && current.categoria == "televendas"
        && current.empresa_id == data.empresa_id
        && current.supermercado_id == data.supermercado_id
        && current.ultima_auditoria_atualizacao_id == auditId
        && previous.get("ultima_auditoria_atualizacao_id", null) != auditId
        && data.details.statusAnterior == previous.status
        && data.details.statusAtual == current.status
        && data.details.atualizado_em == current.atualizado_em
        && current.atualizado_em != previous.get("atualizado_em", null)
        && data.details.operador_nome == current.operador_nome
        && (
          current.status != previous.status
          || current.itens != previous.get("itens", [])
          || current.get("confirmacoes_empilhadeira", {}) != previous.get("confirmacoes_empilhadeira", {})
          || current.get("observacao_operador", null) != previous.get("observacao_operador", null)
          || current.get("motivo_incompleto", null) != previous.get("motivo_incompleto", null)
        );
    }

    match /auditoria/{id} {
      allow read: if isCurrentUserActive()
        && (
          isAdminGeral()
          || (
            "empresa_id" in resource.data
            && canAccessEmpresa(resource.data.empresa_id)
          )
          || (
            "supermercado_id" in resource.data
            && canAccessCurrentSupermercado(resource.data.supermercado_id)
          )
        );

      // Separate short-circuit branch prevents the generic audit validator
      // from exhausting the rules expression budget for atomic call updates.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          "action", "actorUid", "actorName", "entityType", "entityId",
          "details", "occurredAt", "empresa_id", "supermercado_id"
        ])
        && request.resource.data.action == "chamado_atualizado"
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.details is map
        && request.resource.data.empresa_id is string
        && request.resource.data.supermercado_id is string
        && request.resource.data.details.empresa_id == request.resource.data.empresa_id
        && request.resource.data.details.supermercado_id == request.resource.data.supermercado_id
        && request.resource.data.keys().hasOnly([
          "action", "actorUid", "actorName", "entityType", "entityId",
          "details", "occurredAt", "empresa_id", "supermercado_id", "metadata"
        ])
        && isTelevendasAuditActorInScope(request.resource.data)
        && isTelevendasUpdateAuditAuthentic(id, request.resource.data);

      allow create: if isSignedIn()
        && (request.resource.data.get("action", null) == "chamado_assumido"
          && request.resource.data.get("details", {}).get("statusAtual", null) == "Aguardando")
          || (request.resource.data.get("action", null) == "chamado_iniciado"
            && request.resource.data.get("details", {}).get("statusAtual", null) == "Em atendimento")
          || (request.resource.data.get("action", null) == "chamado_finalizado"
            && request.resource.data.get("details", {}).get("statusAtual", null) == "Finalizado")
          ? isOperatorCallActionAudit(id)
          : request.resource.data.keys().hasAll([
          "action",
          "actorUid",
          "actorName",
          "entityType",
          "entityId",
          "details",
          "occurredAt"
        ])
        && request.resource.data.action != "chamado_atualizado"
        && isCurrentUserActive()
        && request.resource.data.keys().hasOnly([
          "action",
          "actorUid",
          "actorName",
          "entityType",
          "entityId",
          "details",
          "occurredAt",
          "empresa_id",
          "supermercado_id",
          "metadata"
        ])
        && request.resource.data.action in [
          "chamado_criado",
          "chamado_assumido",
          "chamado_iniciado",
          "chamado_finalizado",
          "empilhadeira_criada",
          "empilhadeira_atualizada",
          "empilhadeira_status_alterado",
          "manutencao_criada",
          "manutencao_atualizada"
        ]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.occurredAt is string
        && request.resource.data.details is map
        && (
          !("empresa_id" in request.resource.data)
          || (
            request.resource.data.empresa_id is string
            && request.resource.data.details.empresa_id == request.resource.data.empresa_id
          )
        )
        && (
          !("supermercado_id" in request.resource.data)
          || (
            request.resource.data.supermercado_id is string
            && request.resource.data.details.supermercado_id == request.resource.data.supermercado_id
          )
        )
        && (
          isAdminGeral()
          || (
            "empresa_id" in request.resource.data
            && canAccessEmpresa(request.resource.data.empresa_id)
          )
          || (
            "supermercado_id" in request.resource.data
            && canAccessCurrentSupermercado(request.resource.data.supermercado_id)
          )
        );
    }

    match /empresas/{id} {
      allow read: if !isSignedIn() || canAccessEmpresa(id) || belongsToEmpresa(id);
      allow write: if isAdminGeral();

      match /assinaturas/{assinaturaId} {
        allow read: if isActiveSaasPlatformAdmin() || isActiveSaasCompanyAdmin(id);
        allow create, update: if assinaturaId == "atual"
          && isActiveSaasPlatformAdmin()
          && request.resource.data.keys().hasAll(["ultima_operacao_id", "plano_id"])
          && request.resource.data.ultima_operacao_id is string
          && request.resource.data.plano_id is string
          && existsAfter(saasOperationPath(request.resource.data.ultima_operacao_id))
          && getAfter(saasOperationPath(request.resource.data.ultima_operacao_id)).data.target_id == id
          && getAfter(saasOperationPath(request.resource.data.ultima_operacao_id)).data.action in ["assignPlan", "activate", "renew"]
          && isSaasSubscriptionValid(
            id,
            request.resource.data,
            resource == null ? {} : resource.data,
            request.resource.data.ultima_operacao_id,
            getAfter(saasOperationPath(request.resource.data.ultima_operacao_id)).data.action
          );
        allow delete: if false;
      }

      match /historico_assinatura/{eventoId} {
        allow read: if isActiveSaasPlatformAdmin() || isActiveSaasCompanyAdmin(id);
        allow create: if isActiveSaasPlatformAdmin() && isSaasHistoryValid(id, eventoId, request.resource.data);
        allow update, delete: if false;
      }
    }

    match /planos/{planoId} {
      allow read: if isActiveSaasPlatformAdmin();
      allow create, update: if isActiveSaasPlatformAdmin()
        && isSaasPlanValid(planoId, request.resource.data)
        && request.resource.data.ultima_operacao_id is string
        && existsAfter(saasOperationPath(request.resource.data.ultima_operacao_id))
        && existsAfter(saasAuditPath(request.resource.data.ultima_operacao_id))
        && getAfter(saasOperationPath(request.resource.data.ultima_operacao_id)).data.action == "savePlan"
        && getAfter(saasOperationPath(request.resource.data.ultima_operacao_id)).data.target_id == planoId
        && getAfter(saasAuditPath(request.resource.data.ultima_operacao_id)).data.plano_id == planoId
        && (resource == null || request.resource.data.criado_em == resource.data.criado_em);
      allow delete: if false;
    }

    match /auditoria_assinaturas/{eventoId} {
      allow read: if isActiveSaasPlatformAdmin();
      allow create: if isActiveSaasPlatformAdmin()
        && request.resource.data.keys().hasAll(["acao", "plano_id", "operation_id", "ator_uid", "ator_nome", "ocorrido_em", "detalhes"])
        && request.resource.data.keys().hasOnly(["acao", "plano_id", "operation_id", "ator_uid", "ator_nome", "ocorrido_em", "detalhes"])
        && request.resource.data.operation_id == eventoId
        && request.resource.data.ator_uid == request.auth.uid
        && request.resource.data.ator_nome is string
        && request.resource.data.ocorrido_em == request.time
        && request.resource.data.acao in ["plano_criado", "plano_editado"]
        && request.resource.data.detalhes is map
        && existsAfter(saasOperationPath(eventoId))
        && getAfter(saasOperationPath(eventoId)).data.action == "savePlan"
        && getAfter(saasOperationPath(eventoId)).data.target_id == request.resource.data.plano_id
        && getAfter(saasOperationPath(eventoId)).data.actor_uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /assinatura_operacoes/{operationId} {
      // The platform admin must read a prior operation to return its original result on retry.
      allow get: if isActiveSaasPlatformAdmin();
      allow list: if false;
      allow create: if isActiveSaasPlatformAdmin() && isSaasOperationValid(operationId, request.resource.data);
      allow update, delete: if false;
    }

    match /supermercados/{id} {
      allow read: if !isSignedIn()
        || canAccessEmpresa(resource.data.empresa_id)
        || canAccessCurrentSupermercado(id);
      allow create: if isAdminEmpresaDaEmpresa(request.resource.data.empresa_id);
      allow update: if isAdminEmpresaDaEmpresa(resource.data.empresa_id)
        && isAdminEmpresaDaEmpresa(request.resource.data.empresa_id)
        && request.resource.data.empresa_id == resource.data.empresa_id;
      allow delete: if isAdminEmpresaDaEmpresa(resource.data.empresa_id);
    }

    match /empilhadeiras/{id} {
      allow read: if isCurrentUserActive()
        && (
          canAccessEmpresa(resource.data.empresa_id)
          || canAccessCurrentSupermercado(resource.data.supermercado_id)
        );
      allow create: if hasAdminManagementAccess()
        && canAccessEmpresa(request.resource.data.empresa_id)
        && isEmpilhadeiraValida(request.resource.data, id);
      allow update: if (
          isAdminGeral()
          || isAdminEmpresaDaEmpresa(resource.data.empresa_id)
          || isSupervisorDaUnidade(resource.data.supermercado_id)
        )
        && (
          isAdminGeral()
          || request.resource.data.empresa_id == resource.data.empresa_id
        )
        && isEmpilhadeiraValida(request.resource.data, id)
        && request.resource.data.criado_em == resource.data.criado_em
        && (
          isAdminGeral()
          || isAdminEmpresaDaEmpresa(resource.data.empresa_id)
          || (
            request.resource.data.empresa_id == resource.data.empresa_id
            && request.resource.data.supermercado_id == resource.data.supermercado_id
            && request.resource.data.identificacao == resource.data.identificacao
            && request.resource.data.modelo == resource.data.modelo
            && request.resource.data.numero_interno == resource.data.numero_interno
          )
        );
      allow delete: if isAdminGeral()
        || isAdminEmpresaDaEmpresa(resource.data.empresa_id);
    }

    match /checklists_empilhadeira/{id} {
      allow read: if isSignedIn()
        && (
          canAccessEmpresa(resource.data.empresa_id)
          || canAccessCurrentSupermercado(resource.data.supermercado_id)
        );
      allow create: if isChecklistEmpilhadeiraValido(request.resource.data, id)
        && canCreateChecklistEmpilhadeira(request.resource.data);
      allow update: if isAdminGeral()
        || isAdminEmpresaDaEmpresa(resource.data.empresa_id)
        || isSupervisorDaUnidade(resource.data.supermercado_id);
      allow delete: if isAdminGeral()
        || isAdminEmpresaDaEmpresa(resource.data.empresa_id);
    }

    match /manutencoes/{id} {
      allow read: if isCurrentUserActive()
        && (
          canAccessEmpresa(resource.data.empresa_id)
          || canAccessCurrentSupermercado(resource.data.supermercado_id)
        );
      allow create: if isManutencaoValida(request.resource.data, id)
        && canCreateManutencao(request.resource.data);
      allow update: if isManutencaoValida(request.resource.data, id)
        && canUpdateManutencao(resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.supermercado_id == resource.data.supermercado_id
        && request.resource.data.empilhadeira_id == resource.data.empilhadeira_id
        && request.resource.data.criado_por == resource.data.criado_por;
      allow delete: if isAdminGeral()
        || isAdminEmpresaDaEmpresa(resource.data.empresa_id);
    }

    match /operational_escalations/{id} {
      allow read: if isSignedIn() && isCurrentUserActive();
      allow create: if isSignedIn()
        && isCurrentUserActive()
        && request.resource.data.unitId is string
        && request.resource.data.unitId.size() > 0
        && request.resource.data.unitName is string
        && request.resource.data.unitName.size() > 0
        && request.resource.data.status in ["active", "resolved"]
        && request.resource.data.severity in ["critical", "medium", "low"]
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          request.resource.data.resolvedAt == null
          || request.resource.data.resolvedAt is string
        );
      allow update: if isSignedIn() && isCurrentUserActive();
      allow delete: if isAdminGeral();
    }

    match /usuarios/{id} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == id
          || isAdminEmpresaDaEmpresa(resource.data.empresa_id)
          || (
            isAdminGeral()
            && resource.data.perfil == "Administrador da Empresa"
            && resource.data.convite_token is string
            && resource.data.convite_token.size() > 0
          )
        );

      allow create: if isSignedIn()
        && request.auth.uid == id
        && request.resource.data.id == request.auth.uid
        && request.resource.data.status == "Ativo"
        && isPerfilValido(request.resource.data.perfil)
        && (
          isPerfilAutoCadastroPermitido(request.resource.data.perfil)
          || isCadastroAdminEmpresaPorConviteValido()
        )
        && isEmpresaVinculoValido(
          request.resource.data.perfil,
          request.resource.data.empresa_id
        )
        && isSupermercadoVinculoValido(
          request.resource.data.perfil,
          request.resource.data.empresa_id,
          request.resource.data.supermercado_id
        );

      // Reject self-promotion before any self-update or admin-management branch.
      // The guard applies to the complete OR expression below.
      allow update: if isSignedIn()
        && !(
          request.auth.uid == id
          && resource.data.get("perfil", null) != "Administrador Geral"
          && request.resource.data.get("perfil", null) == "Administrador Geral"
        )
        && (
          (
          isSignedIn()
          && request.auth.uid == id
          && request.resource.data.id == resource.data.id
          && request.resource.data.nome == resource.data.nome
          && request.resource.data.email == resource.data.email
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.empresa_id == resource.data.empresa_id
          && request.resource.data.status == resource.data.status
          && request.resource.data.criado_em == resource.data.criado_em
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supermercado_id",
            "supermercado_ids",
            "atualizado_em"
          ])
          && isCurrentUserActive()
          && (
            request.resource.data.supermercado_id == resource.data.supermercado_id
            || isSupermercadoDaEmpresaAtivo(resource.data.empresa_id, request.resource.data.supermercado_id)
            || (resource.data.perfil == "Administrador Geral" && request.resource.data.supermercado_id == null)
            || (resource.data.perfil == "Administrador da Empresa" && request.resource.data.supermercado_id == null)
          )
        )
        || (
          resource.data.perfil == "Administrador da Empresa"
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.empresa_id == resource.data.empresa_id
          && hasOnlyUserManagementChanges(resource.data, request.resource.data)
          && isAdminGeral()
          && resource.data.convite_token is string
          && resource.data.convite_token.size() > 0
          && request.resource.data.convite_token == resource.data.convite_token
          && isUsuarioVinculoValido(request.resource.data)
        )
        || (
          resource.data.perfil != "Administrador Geral"
          && request.resource.data.perfil != "Administrador Geral"
          && hasOnlyUserManagementChanges(resource.data, request.resource.data)
          && canAdminEmpresaManageUser(resource.data, request.resource.data)
        )
        );

      allow delete: if isAdminGeral()
        || (
          isAdminEmpresa()
          && request.auth.uid != id
          && resource.data.perfil != "Administrador Geral"
          && resource.data.empresa_id == currentUserEmpresaId()
        );

      match /push_tokens/{deviceId} {
        allow read: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == id
          && isCurrentUserActive()
          && get(/databases/$(database)/documents/usuarios/$(id)).data.status == "Ativo"
          && request.resource.data.keys().hasOnly([
            "token", "uid", "empresa_id", "supermercado_id", "perfil", "status", "updated_at", "platform"
          ])
          && request.resource.data.keys().hasAll([
            "token", "uid", "empresa_id", "supermercado_id", "perfil", "status", "updated_at", "platform"
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.uid == id
          && request.resource.data.empresa_id == get(/databases/$(database)/documents/usuarios/$(id)).data.empresa_id
          && request.resource.data.supermercado_id == get(/databases/$(database)/documents/usuarios/$(id)).data.supermercado_id
          && request.resource.data.perfil == get(/databases/$(database)/documents/usuarios/$(id)).data.perfil
          && request.resource.data.status == "Ativo"
          && request.resource.data.updated_at is string
          && request.resource.data.platform in ["web", "android"];
        allow delete: if isSignedIn()
          && request.auth.uid == id
          && isCurrentUserActive();
      }
    }

    match /convites_admin_empresa/{id} {
      allow get: if (
          isSignedIn() && hasAdminManagementAccess()
        ) || (
          resource.data.id == id
          && resource.data.status == "Pendente"
          && resource.data.expira_em_ms > request.time.toMillis()
        );
      allow list: if isSignedIn() && hasAdminManagementAccess();

      allow create: if hasAdminManagementAccess()
        && request.resource.data.id == id
        && request.resource.data.perfil == "Administrador da Empresa"
        && isEmpresaAtiva(request.resource.data.empresa_id)
        && request.resource.data.status == "Pendente"
        && request.resource.data.expira_em_ms is int
        && request.resource.data.expira_em_ms > request.time.toMillis()
        && isTextoNaoVazio(request.resource.data.criado_em)
        && isTextoNaoVazio(request.resource.data.expira_em)
        && (
          request.resource.data.criado_por_uid == null
          || isTextoNaoVazio(request.resource.data.criado_por_uid)
        )
        && (
          request.resource.data.criado_por_nome == null
          || isTextoNaoVazio(request.resource.data.criado_por_nome)
        )
        && request.resource.data.usado_em == null
        && request.resource.data.usado_por_uid == null
        && request.resource.data.usado_por_nome == null
        && canAccessEmpresa(request.resource.data.empresa_id);

      allow update: if (
          hasAdminManagementAccess()
          && request.resource.data.id == resource.data.id
          && request.resource.data.empresa_id == resource.data.empresa_id
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.criado_em == resource.data.criado_em
          && request.resource.data.expira_em == resource.data.expira_em
          && request.resource.data.expira_em_ms == resource.data.expira_em_ms
          && canAccessEmpresa(resource.data.empresa_id)
        ) || (
          isSignedIn()
          && request.resource.data.id == resource.data.id
          && request.resource.data.empresa_id == resource.data.empresa_id
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.criado_em == resource.data.criado_em
          && request.resource.data.expira_em == resource.data.expira_em
          && request.resource.data.expira_em_ms == resource.data.expira_em_ms
          && resource.data.status == "Pendente"
          && resource.data.expira_em_ms > request.time.toMillis()
          && request.resource.data.status == "Usado"
          && request.resource.data.usado_por_uid == request.auth.uid
          && isTextoNaoVazio(request.resource.data.usado_em)
          && (
            request.resource.data.usado_por_nome == null
            || isTextoNaoVazio(request.resource.data.usado_por_nome)
          )
        );

      allow delete: if hasAdminManagementAccess()
        && canAccessEmpresa(resource.data.empresa_id);
    }
  }
}
